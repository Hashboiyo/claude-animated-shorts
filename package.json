{
  "name": "shorts-dev",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud-rendered animated shorts built with Remotion + Three.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/patch-remotion-gl.mjs",
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "compositions": "node scripts/composition-info.mjs",
    "audio:demo": "node scripts/make-audio.mjs",
    "stills": "node scripts/render-stills.mjs",
    "matrix": "node scripts/make-matrix.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@remotion/three": "4.0.541",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
